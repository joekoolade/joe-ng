-- classes --
top-level public -> [PUBLIC, SUPER]
String -> [PUBLIC, FINAL, SUPER]
Serializable -> [PUBLIC, INTERFACE, ABSTRACT]
Shape (nested interface) -> [STATIC, INTERFACE, ABSTRACT]
PrivNested -> [PRIVATE, STATIC]
ProtNested -> [PROTECTED, STATIC, FINAL]
Abs -> [STATIC, ABSTRACT]
Inner -> []
Color -> [STATIC, FINAL, ENUM]
Anno -> [STATIC, INTERFACE, ABSTRACT, ANNOTATION]
Point -> [STATIC, FINAL]
anonymous -> []
local -> []
int[] -> [PUBLIC, FINAL, ABSTRACT]
String[] -> [PUBLIC, FINAL, ABSTRACT]
PrivNested[][] -> [PRIVATE, FINAL, ABSTRACT]
int -> [PUBLIC, FINAL, ABSTRACT]
modifiers: int=1041 int[]=1041 PrivNested[]=1042 ProtNested[][]=1044 Abs[]=1040 void=1041
-- fields --
CONST -> [PUBLIC, STATIC, FINAL]
vt -> [PRIVATE, VOLATILE, TRANSIENT]
prot -> [PROTECTED, STATIC]
Color.RED -> [PUBLIC, STATIC, FINAL, ENUM]
Color.$VALUES -> [PRIVATE, STATIC, FINAL, SYNTHETIC]
Inner.this$0 -> [FINAL, SYNTHETIC]
Point.x -> [PRIVATE, FINAL]
-- methods and constructors --
main -> [PUBLIC, STATIC]
varargs -> [STATIC, VARARGS]
Abs.run -> [ABSTRACT]
Abs.sync -> [SYNCHRONIZED]
Abs.fp -> [STATIC]
Shape.area -> [PUBLIC, ABSTRACT]
Shape.describe -> [PUBLIC]
System.arraycopy -> [PUBLIC, STATIC, NATIVE]
ProtNested.compareTo(Object) bridge -> [PUBLIC, BRIDGE, SYNTHETIC]
ProtNested.compareTo(ProtNested) -> [PUBLIC]
Color.values -> [PUBLIC, STATIC]
Point.x() -> [PUBLIC]
Inner ctor -> []
Color ctor -> [PRIVATE]
Point ctor -> []
-- parameters --
Inner ctor arg0 -> [FINAL, MANDATED]
Inner ctor arg1 -> []
Color ctor arg0 -> [SYNTHETIC]
Color ctor arg1 -> [SYNTHETIC]
varargs arg0 -> []
-- AccessFlag itself --
ABSTRACT mask=0x400 source=true locations=[CLASS, METHOD, INNER_CLASS]
ANNOTATION mask=0x2000 source=false locations=[CLASS, INNER_CLASS]
BRIDGE mask=0x40 source=false locations=[METHOD]
ENUM mask=0x4000 source=false locations=[CLASS, FIELD, INNER_CLASS]
FINAL mask=0x10 source=true locations=[CLASS, FIELD, METHOD, INNER_CLASS, METHOD_PARAMETER]
INTERFACE mask=0x200 source=false locations=[CLASS, INNER_CLASS]
MANDATED mask=0x8000 source=false locations=[METHOD_PARAMETER, MODULE, MODULE_REQUIRES, MODULE_EXPORTS, MODULE_OPENS]
MODULE mask=0x8000 source=false locations=[CLASS]
NATIVE mask=0x100 source=true locations=[METHOD]
OPEN mask=0x20 source=false locations=[MODULE]
PRIVATE mask=0x2 source=true locations=[FIELD, METHOD, INNER_CLASS]
PROTECTED mask=0x4 source=true locations=[FIELD, METHOD, INNER_CLASS]
PUBLIC mask=0x1 source=true locations=[CLASS, FIELD, METHOD, INNER_CLASS]
STATIC mask=0x8 source=true locations=[FIELD, METHOD, INNER_CLASS]
STATIC_PHASE mask=0x40 source=false locations=[MODULE_REQUIRES]
STRICT mask=0x800 source=true locations=[]
SUPER mask=0x20 source=false locations=[CLASS]
SYNCHRONIZED mask=0x20 source=true locations=[METHOD]
SYNTHETIC mask=0x1000 source=false locations=[CLASS, FIELD, METHOD, INNER_CLASS, METHOD_PARAMETER, MODULE, MODULE_REQUIRES, MODULE_EXPORTS, MODULE_OPENS]
TRANSIENT mask=0x80 source=true locations=[FIELD]
TRANSITIVE mask=0x20 source=false locations=[MODULE_REQUIRES]
VARARGS mask=0x80 source=false locations=[METHOD]
VOLATILE mask=0x40 source=true locations=[FIELD]
AccessFlagsProbe done
