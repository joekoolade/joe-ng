format probe:
  [plain] -> [plain]
  [one %s] -> [one A]
  [expected: <%s> but was: <%s>] -> [expected: <2> but was: <3>]
  [expected: %s but was: %s] -> [expected: x but was: y]
  [%d and %d] -> [7 and 8]
  [%x %o %c %b] -> [ff 10 Z true]
  [null arg <%s>] -> [null arg <null>]
  [100%% done] -> [100% done]
  [%-10s|] -> [pad       |]
  [%q unknown] -> [THREW java.util.UnknownFormatConversionException]
  -- width --
  [%5d|] -> [   42|]
  [%-5d|] -> [42   |]
  [%05d|] -> [00042|]
  [%5d|] -> [  -42|]
  [%-5d|] -> [-42  |]
  [%05d|] -> [-0042|]
  [%2d|] -> [12345|]
  [%5s|] -> [   ab|]
  [%-5s|] -> [ab   |]
  [%5c|] -> [    Z|]
  [%5b|] -> [ true|]
  [%5s|] -> [ null|]
  [[%5d][%-5s]] -> [[    7][q    ]]
  [%5%|] -> [    %|]
  -- precision --
  [%.2s|] -> [ab|]
  [%.0s|] -> [|]
  [%8.3s|] -> [     abc|]
  [%-8.3s|] -> [abc     |]
  [%.2b|] -> [tr|]
  -- sign and grouping --
  [%+d|] -> [+42|]
  [%+d|] -> [-42|]
  [% d|] -> [ 42|]
  [% d|] -> [-42|]
  [%(d|] -> [(42)|]
  [%(d|] -> [42|]
  [%,d|] -> [12,345,678|]
  [%,d|] -> [-12,345,678|]
  [%,d|] -> [123|]
  [%+,09d|] -> [+0012,345|]
  [%d|] -> [-9223372036854775808|]
  [%,d|] -> [-9,223,372,036,854,775,808|]
  -- radix and alternate form --
  [%#x|] -> [0xff|]
  [%#X|] -> [0XFF|]
  [%08x|] -> [000000ff|]
  [%-8x|] -> [ff      |]
  [%#010x|] -> [0x000000ff|]
  [%#o|] -> [010|]
  -- unsigned at the argument's width --
  [%x|] -> [ffffffff|]
  [%x|] -> [ffffffffffffffff|]
  [%x|] -> [ffff|]
  [%x|] -> [ff|]
  [%o|] -> [37777777777|]
  [%X|] -> [FFFFFF01|]
  -- floating point --
  [%f|] -> [1.500000|]
  [%f|] -> [-1.500000|]
  [%.2f|] -> [3.14|]
  [%.0f|] -> [3|]
  [%.2f|] -> [2.68|]
  [%.3f|] -> [0.001|]
  [%10.2f|] -> [      3.14|]
  [%-10.2f|] -> [3.14      |]
  [%010.2f|] -> [-000003.14|]
  [%+.2f|] -> [+3.14|]
  [%,.2f|] -> [1,234,567.89|]
  [%(.2f|] -> [(1234.50)|]
  [%f|] -> [0.000000|]
  [%f|] -> [-0.000000|]
  [%f|] -> [NaN|]
  [%f|] -> [Infinity|]
  [%f|] -> [-Infinity|]
  [%f|] -> [1.500000|]
  [%e|] -> [1.234500e+03|]
  [%E|] -> [1.234500E+03|]
  [%.2e|] -> [1.23e-04|]
  [%g|] -> [1234.50|]
  [%g|] -> [1.23450e-05|]
  [%a|] -> [0x1.8p0|]
  -- argument alignment across a float --
  [value=%.2f ok=%s] -> [value=3.14 ok=yes]
  [%s %f %s|] -> [a 1.000000 b|]
  -- %h and argument indexes --
  [%h|] -> [17862|]
  [%h|] -> [null|]
  [%1$s %1$s %2$s|] -> [x x y|]
  [%2$s %1$s|] -> [second first|]
  -- illegal: must throw the SAME exception in both worlds --
  [%.2d|] -> [THREW java.util.IllegalFormatPrecisionException]
  [%#d|] -> [THREW java.util.FormatFlagsConversionMismatchException]
  [%+x|] -> [THREW java.util.FormatFlagsConversionMismatchException]
  [%-05d|] -> [THREW java.util.IllegalFormatFlagsException]
  formatted() = [expected: <2> but was: <3>]
  length      = 26
  printf -> [pw n=7] (want [pw n=7])
  printf x2 -> [a1b2] (want [a1b2])
  format still ok = [x-9] (want [x-9])
survived
