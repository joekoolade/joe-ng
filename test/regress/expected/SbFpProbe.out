-- append(double) --
  1.5 = [1.5]
  0.1 = [0.1]
  -2.75 = [-2.75]
  0.0 = [0.0]
  -0.0 = [-0.0]
  NaN = [NaN]
  +Inf = [Infinity]
  -Inf = [-Infinity]
  1e20 = [1.0E20]
  1e-9 = [1.0E-9]
  MAX = [1.7976931348623157E308]
  MIN = [4.9E-324]
-- append(float): the built-in comparison --
  1.5f = [1.5]
  0.1f = [0.1]
  -0.0f = [-0.0]
  NaN f = [NaN]
-- float is NOT a widened double --
  0.1f vs 0.1d = [0.1|0.10000000149011612]
-- in context, and mixed with other appends --
  surrounded = [[2.5]]
  chained = [1,2.5,3]
-- insert(int, double) / insert(int, float) --
  ins d mid = [a2.5b]
  ins f mid = [a0.5b]
  ins d head = [-1.25ab]
  ins d tail = [ab9.75]
  ins d NaN = [aNaNb]
SbFpProbe done
