# Build artifacts (regenerated by scripts/build.sh from the seed JDK).
out/
kernel8.img
tmp/
sdcard/

# Firmware download archives (extract into ramfs/lib/firmware/; do not commit).
fw.tar.gz
*.tar.gz

# WiFi credentials (real SSID/password) stay local-only
ramfs/etc/wifi.conf

# M4: generated plugin classes (compiled from plugins-src/ into ramfs at build time)
ramfs/plugins/

# The classpath jar + its staging dir (built from jarsrc/ at image time)
ramfs/lib/app.jar
.appjar/

# JUnit console-standalone jar (downloaded by `make junit`; host-side test tooling, not vendored).
jars/

# Staged by `make junitjar` from jars/ (itself gitignored) -- a 3 MB third-party binary, never vendored.
ramfs/lib/junit.jar
